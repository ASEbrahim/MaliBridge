; Tessellation control shader in glslang's shape: gl_in[32] {Position, ClipDistance[1]} in,
; gl_out[3] {Position, ClipDistance[1]} out (arrayed output), indexed by InvocationId.
               OpCapability Shader
               OpCapability Tessellation
               OpCapability ClipDistance
               OpMemoryModel Logical GLSL450
               OpEntryPoint TessellationControl %main "main" %gl_in %gl_out %iid %outer
               OpExecutionMode %main OutputVertices 3
               OpDecorate %iid BuiltIn InvocationId
               OpDecorate %outer BuiltIn TessLevelOuter
               OpDecorate %outer Patch
               OpMemberDecorate %PerVertexIn 0 BuiltIn Position
               OpMemberDecorate %PerVertexIn 1 BuiltIn ClipDistance
               OpDecorate %PerVertexIn Block
               OpMemberDecorate %PerVertexOut 0 BuiltIn Position
               OpMemberDecorate %PerVertexOut 1 BuiltIn ClipDistance
               OpDecorate %PerVertexOut Block
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
      %float = OpTypeFloat 32
    %v4float = OpTypeVector %float 4
        %int = OpTypeInt 32 1
       %uint = OpTypeInt 32 0
     %uint_1 = OpConstant %uint 1
     %uint_3 = OpConstant %uint 3
     %uint_4 = OpConstant %uint 4
    %uint_32 = OpConstant %uint 32
     %float1 = OpTypeArray %float %uint_1
     %float4 = OpTypeArray %float %uint_4
%PerVertexIn = OpTypeStruct %v4float %float1
     %in_arr = OpTypeArray %PerVertexIn %uint_32
      %in_pv = OpTypePointer Input %in_arr
      %gl_in = OpVariable %in_pv Input
%PerVertexOut = OpTypeStruct %v4float %float1
    %out_arr = OpTypeArray %PerVertexOut %uint_3
     %out_pv = OpTypePointer Output %out_arr
     %gl_out = OpVariable %out_pv Output
     %in_int = OpTypePointer Input %int
        %iid = OpVariable %in_int Input
  %out_outer = OpTypePointer Output %float4
      %outer = OpVariable %out_outer Output
      %int_0 = OpConstant %int 0
      %int_1 = OpConstant %int 1
    %float_1 = OpConstant %float 1
      %in_v4 = OpTypePointer Input %v4float
   %in_float = OpTypePointer Input %float
     %out_v4 = OpTypePointer Output %v4float
  %out_float = OpTypePointer Output %float
       %main = OpFunction %void None %fn
      %entry = OpLabel
          %i = OpLoad %int %iid
         %pp = OpAccessChain %in_v4 %gl_in %i %int_0
          %p = OpLoad %v4float %pp
         %op = OpAccessChain %out_v4 %gl_out %i %int_0
               OpStore %op %p
         %cp = OpAccessChain %in_float %gl_in %i %int_1 %int_0
          %c = OpLoad %float %cp
         %oc = OpAccessChain %out_float %gl_out %i %int_1 %int_0
               OpStore %oc %c
         %o0 = OpAccessChain %out_float %outer %int_0
               OpStore %o0 %float_1
               OpReturn
               OpFunctionEnd
