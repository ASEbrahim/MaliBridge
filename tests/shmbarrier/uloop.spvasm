; shm_barrier: a top-level write, then a uniform loop (counter from 0 to 4) with a non-uniform if (i < 16) that reads and writes. Level 1: a barrier at the loop's entry, a memory one before the write. Level 2: the barrier at the if's entry in every iteration (it also orders one iteration against the next), the memory one as before.
               OpCapability Shader
               OpMemoryModel Logical GLSL450
               OpEntryPoint GLCompute %main "main" %lid
               OpExecutionMode %main LocalSize 64 1 1
               OpDecorate %lid BuiltIn LocalInvocationIndex
               OpDecorate %Buf Block
               OpDecorate %arr ArrayStride 4
               OpMemberDecorate %Buf 0 Offset 0
               OpDecorate %buf DescriptorSet 0
               OpDecorate %buf Binding 0
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
       %uint = OpTypeInt 32 0
       %bool = OpTypeBool
     %uint_0 = OpConstant %uint 0
     %uint_1 = OpConstant %uint 1
     %uint_4 = OpConstant %uint 4
    %uint_16 = OpConstant %uint 16
    %uint_63 = OpConstant %uint 63
    %uint_64 = OpConstant %uint 64
       %pFn = OpTypePointer Function %uint
        %arr = OpTypeRuntimeArray %uint
        %Buf = OpTypeStruct %arr
       %pBuf = OpTypePointer StorageBuffer %Buf
        %pSB = OpTypePointer StorageBuffer %uint
        %buf = OpVariable %pBuf StorageBuffer
        %pIn = OpTypePointer Input %uint
        %lid = OpVariable %pIn Input
       %sarr = OpTypeArray %uint %uint_64
       %pWGa = OpTypePointer Workgroup %sarr
        %pWG = OpTypePointer Workgroup %uint
         %sh = OpVariable %pWGa Workgroup
       %main = OpFunction %void None %fn
      %entry = OpLabel
          %i = OpLoad %uint %lid
          %p = OpAccessChain %pWG %sh %i
               OpStore %p %i
               OpBranch %hdr
        %hdr = OpLabel
          %k = OpPhi %uint %uint_0 %entry %k1 %cont
               OpLoopMerge %mrg %cont None
               OpBranch %cond
       %cond = OpLabel
          %c = OpULessThan %bool %k %uint_4
               OpBranchConditional %c %body %mrg
       %body = OpLabel
         %c2 = OpULessThan %bool %i %uint_16
               OpSelectionMerge %join None
               OpBranchConditional %c2 %then %join
       %then = OpLabel
          %j = OpIAdd %uint %i %uint_16
          %q = OpAccessChain %pWG %sh %j
          %v = OpLoad %uint %q
               OpStore %p %v
               OpBranch %join
       %join = OpLabel
               OpBranch %cont
       %cont = OpLabel
         %k1 = OpIAdd %uint %k %uint_1
               OpBranch %hdr
        %mrg = OpLabel
          %r = OpLoad %uint %p
          %o = OpAccessChain %pSB %buf %uint_0 %i
               OpStore %o %r
               OpReturn
               OpFunctionEnd
