#version 450
#pragma use_vulkan_memory_model
#extension GL_KHR_memory_scope_semantics : require
// wave32 corpus: wave32.comp in the Vulkan memory model (the exchanges' accesses get NonPrivatePointer).
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Out { uint o[]; };

void main()
{
    uint g = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
    uint x = (g * 2654435761u) >> 20;
    uvec4 b = subgroupBallot((x & 1u) != 0u);
    uint count = bitCount(b.x);
    uint s = x;
    for (uint d = 16u; d > 0u; d >>= 1u)
        s += subgroupShuffleXor(s, d);
    uint pre = subgroupExclusiveAdd(x & 7u);
    o[g * 4u + 0u] = count;
    o[g * 4u + 1u] = s;
    o[g * 4u + 2u] = gl_SubgroupInvocationID | (gl_SubgroupSize << 8) | (gl_SubgroupID << 16) | (gl_NumSubgroups << 24);
    o[g * 4u + 3u] = pre;
}
