#version 450
// gamescope's composite form: a storage image declared rgba8, written whatever the view's format (Steam's blue #1A9FFF)
layout(local_size_x = 4, local_size_y = 4) in;
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D dst;
void main() { imageStore(dst, ivec2(gl_GlobalInvocationID.xy), vec4(26.0 / 255.0, 159.0 / 255.0, 1.0, 1.0)); }
