#version 450
// Samples texel (1,1) of the image (as gamescope's RCAS / pipewire passes read their inputs), 0-255 per channel
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) uniform sampler2D tex;
layout(set = 0, binding = 1) buffer O { uint v[4]; } o;
void main() {
    vec4 t = texelFetch(tex, ivec2(1), 0);
    for (int c = 0; c < 4; c++) o.v[c] = uint(t[c] * 255.0 + 0.5);
}
