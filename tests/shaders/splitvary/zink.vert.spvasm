; splitvary_check: vec4.vert written like Zink's SPIR-V (SPIR-V 1.6, Vulkan memory model, Position as a
; plain BuiltIn variable, no gl_PerVertex block); texcoord one vec4 at Location 1.
               OpCapability Shader
               OpCapability VulkanMemoryModel
               OpMemoryModel Logical Vulkan
               OpEntryPoint Vertex %main "main" %vid %pos %col %tc %quad
               OpDecorate %vid BuiltIn VertexIndex
               OpDecorate %pos BuiltIn Position
               OpDecorate %col Location 0
               OpDecorate %tc Location 1
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
      %float = OpTypeFloat 32
        %int = OpTypeInt 32 1
       %uint = OpTypeInt 32 0
     %v2float = OpTypeVector %float 2
     %v4float = OpTypeVector %float 4
     %uint_6 = OpConstant %uint 6
     %arr = OpTypeArray %v2float %uint_6
   %p_in_int = OpTypePointer Input %int
  %p_out_v4 = OpTypePointer Output %v4float
  %p_priv_arr = OpTypePointer Private %arr
  %p_priv_v2 = OpTypePointer Private %v2float
         %f0 = OpConstant %float 0
         %f1 = OpConstant %float 1
         %f2 = OpConstant %float 2
       %f05 = OpConstant %float 0.5
      %f075 = OpConstant %float 0.75
        %c00 = OpConstantComposite %v2float %f0 %f0
        %c10 = OpConstantComposite %v2float %f1 %f0
        %c01 = OpConstantComposite %v2float %f0 %f1
        %c11 = OpConstantComposite %v2float %f1 %f1
       %quadc = OpConstantComposite %arr %c00 %c10 %c01 %c10 %c11 %c01
        %vid = OpVariable %p_in_int Input
        %pos = OpVariable %p_out_v4 Output
        %col = OpVariable %p_out_v4 Output
         %tc = OpVariable %p_out_v4 Output
       %quad = OpVariable %p_priv_arr Private %quadc
       %main = OpFunction %void None %fn
          %l = OpLabel
          %i = OpLoad %int %vid
         %pp = OpAccessChain %p_priv_v2 %quad %i
         %uv = OpLoad %v2float %pp
          %u = OpCompositeExtract %float %uv 0
          %v = OpCompositeExtract %float %uv 1
         %x2 = OpFMul %float %u %f2
          %x = OpFSub %float %x2 %f1
         %y2 = OpFMul %float %v %f2
          %y = OpFSub %float %y2 %f1
         %p4 = OpCompositeConstruct %v4float %x %y %f05 %f1
               OpStore %pos %p4
         %c4 = OpCompositeConstruct %v4float %u %v %f0 %f1
               OpStore %col %c4
         %q = OpFAdd %float %f1 %u
         %t4 = OpCompositeConstruct %v4float %u %v %f075 %q
               OpStore %tc %t4
               OpReturn
               OpFunctionEnd
