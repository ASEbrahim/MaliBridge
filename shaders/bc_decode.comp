#version 450
/* SPDX-License-Identifier: GPL-3.0-or-later
 * Copyright (C) 2026 ASEbrahim and MaliBridge contributors
 *
 * BCn block decoder for the Mali bridge's BC texture emulation. One invocation decodes one 4x4
 * block from the copy's source buffer and writes its texels, packed in the decoded format, to a
 * scratch buffer laid out as whole blocks (rows of 4 * blocks texels, 4 * blocks rows per layer);
 * the bridge then copies the buffer into the image, which so needs no storage usage. The
 * arithmetic follows bcdec (third_party/bcdec, MIT/Unlicense, Sergii Kudlai) so the output can be
 * checked bit-for-bit against it. Built once per format family (FMT_BC1 ... FMT_BC7), and BC1
 * once more with PACK16: R5G6B5 (BC1 without alpha) or A1R5G5B5 texels, half the memory of RGBA8;
 * BC1's endpoints are 5:6:5, so only interpolated colours lose precision.
 *
 * Transcoding variants (ENC_ETC2, ENC_ASTC, ENC_EAC, ENC_ASTC_HDR) encode the decoded block again,
 * into ETC2 RGB8 / RGB8A1 (BC1), ASTC 4x4 (BC2, BC3, BC7), EAC R11 / RG11 (BC4, BC5) or ASTC 4x4
 * HDR (BC6H), and write the blocks to the scratch buffer in order (rows of blocks, layer after
 * layer): the image stays compressed on a GPU without BC (etc2_enc.glsl, astc_enc.glsl,
 * eac_enc.glsl, astc_hdr_enc.glsl). BC_QUALITY (below) trades their search for time.
 *
 * SRC_RAW variants encode texels instead of BC blocks: those of a decoded BC image, copied out to a
 * buffer, for a copy from it into a transcoded one (server_emu_bcn.c copy_mixed). FMT_* then names
 * what the texels are: RGBA8 or 16-bit (FMT_BC1 / FMT_BC3), R8 (FMT_BC4), RG8 (FMT_BC5) or RGBA16F
 * (FMT_BC6H). The encoder is the transcoder's, so the image gets what an upload of the same
 * colours would have.
 */
layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, binding = 0) readonly buffer Src { uint w[]; } src;
layout(std430, binding = 1) writeonly buffer Dst { uint w[]; } dst;

#if defined(ENC_ETC2) || defined(ENC_ASTC) || defined(ENC_EAC) || defined(ENC_ASTC_HDR) || defined(ENC_ASTCN)
#define TRANSCODE
#endif

/* 32-bit words one row of a block's texels takes: 16-bit, RGBA16F, R8, RG8, RGBA8. */
#if defined(TRANSCODE)
#define ROW_WORDS 1u
#elif defined(PACK16)
#define ROW_WORDS 2u
#elif defined(FMT_BC6H)
#define ROW_WORDS 8u
#elif defined(FMT_BC4)
#define ROW_WORDS 1u
#elif defined(FMT_BC5)
#define ROW_WORDS 2u
#else
#define ROW_WORDS 4u
#endif

layout(push_constant) uniform PC {
    uint src_word;     /* first block, in 32-bit words from the bound range's start */
    uint row_blocks;   /* blocks per row in the buffer */
    uint layer_blocks; /* blocks per layer in the buffer */
    uint flags;        /* 1: BC1 without alpha (alpha forced to 1; R5G6B5 with PACK16); 2: signed (BC4/5/6H);
                        * 4: ETC2 RGB8A1 (punch-through alpha); SRC_RAW: 8: R5G6B5 texels, 16: A1R5G5B5 texels,
                        * 32: BC7's finer ASTC search */
    uint dst_word;     /* where the region's texels start in the scratch buffer, in 32-bit words */
    uint pad;
    uvec2 extent;      /* texels to decode (ENC_ASTCN: the piece's, from the first ASTC block's corner) */
#if defined(ENC_ASTCN)
    uvec4 nx;          /* ENC_ASTCN: x: how far the region starts past its first ASTC block's corner (bits 0-3 x,
                        * 4-7 y) and its first block row bound (bits 8-31); y: the piece's first texel row (from
                        * that corner); zw: the region's extent in texels */
#endif
} pc;

#extension GL_GOOGLE_include_directive : require
#if defined(BC_PALETTE) || defined(BC_FAST)
#extension GL_EXT_control_flow_attributes : require
#endif
#include "bc_tables.glsl"

/* REGION_TABLE (the 4x4 decoders and transcoders, VKBRIDGE_BC_ONE_DISPATCH): one dispatch converts a run of regions.
 * With pc.pad 1 the dispatch is one row of workgroups and binding 2 holds pc.row_blocks entries of two uvec4 (from
 * entry pc.src_word): the region's first source word, blocks per row, blocks per layer, first scratch word; its
 * extent in texels, its first workgroup, its workgroups a row | rows of them << 16. A workgroup finds its entry by
 * a binary search on the first workgroups (the same for all its invocations) and converts the blocks the region's
 * own dispatch would have given it (same reads, same writes). pc.pad 0: the push constants describe one region as
 * without the table. Without REGION_TABLE the macros below are the push constants and the invocation's id, as
 * before (the same SPIR-V). */
#if defined(REGION_TABLE)
layout(std430, binding = 2) readonly buffer Tab { uvec4 e[]; } tab;
uvec3 g_gid;
uvec2 g_ext;
uint g_src, g_rowb, g_layb, g_dst;
#define GID g_gid
#define EXTENT g_ext
#define SRC_WORD g_src
#define ROW_BLOCKS g_rowb
#define LAYER_BLOCKS g_layb
#define DST_WORD g_dst
void region_find()
{
    if (pc.pad == 0u) {
        g_gid = gl_GlobalInvocationID;
        g_ext = pc.extent;
        g_src = pc.src_word, g_rowb = pc.row_blocks, g_layb = pc.layer_blocks, g_dst = pc.dst_word;
        return;
    }
    uint wg = gl_WorkGroupID.x, lo = pc.src_word, a = 0u, b = pc.row_blocks;
    while (b - a > 1u) { /* the last entry whose first workgroup is at or before this one */
        uint m = (a + b) >> 1;
        if (tab.e[2u * (lo + m) + 1u].z <= wg) a = m;
        else b = m;
    }
    uvec4 e0 = tab.e[2u * (lo + a)], e1 = tab.e[2u * (lo + a) + 1u];
    uint wx = e1.w & 0xffffu, wy = e1.w >> 16, local = wg - e1.z, plane = wx * wy;
    uint r = local % plane;
    g_gid = uvec3(uvec2(r % wx, r / wx) * 8u + gl_LocalInvocationID.xy, local / plane);
    g_ext = e1.xy;
    g_src = e0.x, g_rowb = e0.y, g_layb = e0.z, g_dst = e0.w;
}
#else
#define GID gl_GlobalInvocationID
#define EXTENT pc.extent
#define SRC_WORD pc.src_word
#define ROW_BLOCKS pc.row_blocks
#define LAYER_BLOCKS pc.layer_blocks
#define DST_WORD pc.dst_word
#endif

uint bits(uvec4 b, uint pos, uint n)
{
    if (n == 0u) return 0u;
    uint wi = pos >> 5, o = pos & 31u;
#if defined(BC_FAST) && defined(FMT_BC7)
    /* the words by select (a vector indexed by data was kept on the stack) */
    uint lo = wi == 0u ? b.x : (wi == 1u ? b.y : (wi == 2u ? b.z : b.w)), hi = wi == 0u ? b.y : (wi == 1u ? b.z : b.w);
    uint v = lo >> o;
    if (o + n > 32u && wi < 3u) v |= hi << (32u - o);
#else
    uint v = b[wi] >> o;
    if (o + n > 32u && wi < 3u) v |= b[wi + 1u] << (32u - o);
#endif
    return n == 32u ? v : (v & ((1u << n) - 1u));
}

int sext(int v, int n) { return (v << (32 - n)) >> (32 - n); }

uint outw[4u * ROW_WORDS]; /* the block's texels, packed */

uint bswap32(uint v) { return (v >> 24) | ((v >> 8) & 0xff00u) | ((v << 8) & 0xff0000u) | (v << 24); }

#if defined(TRANSCODE)
/* How hard the encoders search (VKBRIDGE_BC_TRANSCODE_QUALITY, a specialization constant): 0 fast,
 * 1 the default, 2 high. */
layout(constant_id = 0) const uint BC_QUALITY = 1u;
ivec4 g_px[16]; /* the block's texels, 8-bit RGBA, for the encoder */
uint g_bc7_parts, g_bc7_part, g_bc7_mask; /* a BC7 block's subsets, partition and its subset per texel */
#if defined(ENC_ETC2)
#include "etc2_enc.glsl"
#elif defined(ENC_ASTC)
#include "astc_enc.glsl"
#if defined(BC_FAST) && defined(FMT_BC7) && !defined(SRC_RAW) /* VKBRIDGE_BC_FAST: the same encoder, less state */
#include "astc_fast.glsl"
#endif
#elif defined(ENC_ASTC_HDR)
uvec3 g_hpx[16]; /* BC6H: the block's texels as half floats */
#include "astc_enc.glsl"
#include "astc_hdr_enc.glsl"
#elif defined(ENC_ASTCN)
#include "astc_enc.glsl"
#include "astcn_enc.glsl"
#else
#include "eac_enc.glsl"
#endif
#endif

void put(uint tx, uint ty, vec4 v)
{
#if defined(ENC_ASTC_HDR)
    g_hpx[ty * 4u + tx] = uvec3(packHalf2x16(vec2(v.r, 0.0)), packHalf2x16(vec2(v.g, 0.0)), packHalf2x16(vec2(v.b, 0.0)));
#elif defined(TRANSCODE)
    g_px[ty * 4u + tx] = ivec4(round(clamp(v, 0.0, 1.0) * 255.0));
#elif defined(PACK16)
    bool rgb = (pc.flags & 1u) != 0u;
    uvec4 q = uvec4(round(clamp(v, 0.0, 1.0) * vec4(31.0, rgb ? 63.0 : 31.0, 31.0, 1.0)));
    uint p = rgb ? (q.r << 11) | (q.g << 5) | q.b : (q.a << 15) | (q.r << 10) | (q.g << 5) | q.b;
    outw[ty * 2u + (tx >> 1)] = bitfieldInsert(outw[ty * 2u + (tx >> 1)], p, int((tx & 1u) * 16u), 16);
#elif defined(FMT_BC6H)
    outw[ty * 8u + tx * 2u] = packHalf2x16(v.rg);
    outw[ty * 8u + tx * 2u + 1u] = packHalf2x16(v.ba);
#elif defined(FMT_BC4)
    outw[ty] = bitfieldInsert(outw[ty], packUnorm4x8(v) & 0xffu, int(tx * 8u), 8);
#elif defined(FMT_BC5)
    outw[ty * 2u + (tx >> 1)] = bitfieldInsert(outw[ty * 2u + (tx >> 1)], packUnorm4x8(v) & 0xffffu, int((tx & 1u) * 16u), 16);
#else
    outw[ty * 4u + tx] = packUnorm4x8(v);
#endif
}

/* BC6H texels as the half floats the decoder made (no round trip through 32-bit floats). */
void put_half(uint tx, uint ty, uvec3 h)
{
#if defined(ENC_ASTC_HDR)
    g_hpx[ty * 4u + tx] = h & 0xffffu;
#elif defined(FMT_BC6H)
    outw[ty * 8u + tx * 2u] = (h.x & 0xffffu) | (h.y << 16);
    outw[ty * 8u + tx * 2u + 1u] = (h.z & 0xffffu) | (0x3c00u << 16);
#endif
}

/* ------------------------------------------------------------------ BC1-3 */

uvec4 rgb565(uint c)
{
    uint r = (c >> 11) & 31u, g = (c >> 5) & 63u, b = c & 31u;
    return uvec4((r * 527u + 23u) >> 6, (g * 259u + 33u) >> 6, (b * 527u + 23u) >> 6, 255u);
}

void color_block(uint lo, uint idx, bool opaque, inout uvec4 texels[16])
{
    uint c0 = lo & 0xffffu, c1 = lo >> 16;
    uint r0 = (c0 >> 11) & 31u, g0 = (c0 >> 5) & 63u, b0 = c0 & 31u;
    uint r1 = (c1 >> 11) & 31u, g1 = (c1 >> 5) & 63u, b1 = c1 & 31u;
    uvec4 ref[4];
    ref[0] = rgb565(c0);
    ref[1] = rgb565(c1);
    if (c0 > c1 || opaque) {
        ref[2] = uvec4(((2u * r0 + r1) * 351u + 61u) >> 7, ((2u * g0 + g1) * 2763u + 1039u) >> 11, ((2u * b0 + b1) * 351u + 61u) >> 7, 255u);
        ref[3] = uvec4(((r0 + r1 * 2u) * 351u + 61u) >> 7, ((g0 + g1 * 2u) * 2763u + 1039u) >> 11, ((b0 + b1 * 2u) * 351u + 61u) >> 7, 255u);
    } else {
        ref[2] = uvec4(((r0 + r1) * 1053u + 125u) >> 8, ((g0 + g1) * 4145u + 1019u) >> 11, ((b0 + b1) * 1053u + 125u) >> 8, 255u);
        ref[3] = uvec4(0u);
    }
    for (uint t = 0u; t < 16u; t++) texels[t] = ref[(idx >> (2u * t)) & 3u];
}

/* BC3's alpha block as bcdec decodes it (integer division). */
void smooth_alpha(uint lo, uint hi, out uint a[16])
{
    uint a0 = lo & 0xffu, a1 = (lo >> 8) & 0xffu;
    uint pal[8];
    pal[0] = a0;
    pal[1] = a1;
    if (a0 > a1) {
        pal[2] = (6u * a0 + a1) / 7u; pal[3] = (5u * a0 + 2u * a1) / 7u; pal[4] = (4u * a0 + 3u * a1) / 7u;
        pal[5] = (3u * a0 + 4u * a1) / 7u; pal[6] = (2u * a0 + 5u * a1) / 7u; pal[7] = (a0 + 6u * a1) / 7u;
    } else {
        pal[2] = (4u * a0 + a1) / 5u; pal[3] = (3u * a0 + 2u * a1) / 5u; pal[4] = (2u * a0 + 3u * a1) / 5u;
        pal[5] = (a0 + 4u * a1) / 5u; pal[6] = 0u; pal[7] = 255u;
    }
    uvec4 b = uvec4(lo, hi, 0u, 0u);
    for (uint t = 0u; t < 16u; t++) a[t] = pal[bits(b, 16u + 3u * t, 3u)];
}

/* BC4/BC5 channel (bcdec's precise variant), as the byte pattern of the unsigned/signed value. */
void bc4_channel(uint lo, uint hi, bool sgn, out uint v[16])
{
    int e0, e1;
    if (sgn) {
        e0 = max(sext(int(lo & 0xffu), 8), -127);
        e1 = max(sext(int((lo >> 8) & 0xffu), 8), -127);
    } else {
        e0 = int(lo & 0xffu);
        e1 = int((lo >> 8) & 0xffu);
    }
    const int w6[6] = int[6](9363, 18724, 28086, 37450, 46812, 56173);
    const int w4[4] = int[4](13107, 26215, 39321, 52429);
    int pal[8];
    pal[0] = e0;
    pal[1] = e1;
    if (e0 > e1) {
        for (int i = 0; i < 6; i++) pal[2 + i] = (w6[5 - i] * e0 + w6[i] * e1 + 32768) >> 16;
    } else {
        for (int i = 0; i < 4; i++) pal[2 + i] = (w4[3 - i] * e0 + w4[i] * e1 + 32768) >> 16;
        pal[6] = sgn ? -127 : 0;
        pal[7] = sgn ? 127 : 255;
    }
    uvec4 b = uvec4(lo, hi, 0u, 0u);
    for (uint t = 0u; t < 16u; t++) v[t] = uint(pal[bits(b, 16u + 3u * t, 3u)]) & 0xffu;
}

/* The same channel unrounded, in EAC R11 units (0..2047, signed -1023..1023): the encoder starts
 * from BC4's exact interpolants, not from their 8-bit roundings. */
void bc4_exact(uint lo, uint hi, bool sgn, out float v[16])
{
    float e0, e1;
    if (sgn) {
        e0 = float(max(sext(int(lo & 0xffu), 8), -127));
        e1 = float(max(sext(int((lo >> 8) & 0xffu), 8), -127));
    } else {
        e0 = float(lo & 0xffu);
        e1 = float((lo >> 8) & 0xffu);
    }
    float pal[8];
    pal[0] = e0;
    pal[1] = e1;
    if (e0 > e1) {
        for (int i = 1; i < 7; i++) pal[1 + i] = (float(7 - i) * e0 + float(i) * e1) / 7.0;
    } else {
        for (int i = 1; i < 5; i++) pal[1 + i] = (float(5 - i) * e0 + float(i) * e1) / 5.0;
        pal[6] = sgn ? -127.0 : 0.0;
        pal[7] = sgn ? 127.0 : 255.0;
    }
    float sc = sgn ? 1023.0 / 127.0 : 2047.0 / 255.0;
    uvec4 b = uvec4(lo, hi, 0u, 0u);
    for (uint t = 0u; t < 16u; t++) v[t] = pal[bits(b, 16u + 3u * t, 3u)] * sc;
}

/* ------------------------------------------------------------------ BC6H */

int bc6_unquantize(int val, int nbits, bool sgn)
{
    if (!sgn) {
        if (nbits >= 15) return val;
        if (val == 0) return 0;
        if (val == (1 << nbits) - 1) return 0xffff;
        return ((val << 16) + 0x8000) >> nbits;
    }
    if (nbits >= 16) return val;
    int s = 0;
    if (val < 0) { s = 1; val = -val; }
    int unq;
    if (val == 0) unq = 0;
    else if (val >= (1 << (nbits - 1)) - 1) unq = 0x7fff;
    else unq = ((val << 15) + 0x4000) >> (nbits - 1);
    return s != 0 ? -unq : unq;
}

uint bc6_finish(int val, bool sgn)
{
    if (!sgn) return uint((val * 31) >> 6);
    val = val < 0 ? -(((-val) * 31) >> 5) : (val * 31) >> 5;
    uint s = 0u;
    if (val < 0) { s = 0x8000u; val = -val; }
    return s | uint(val);
}

void bc6h(uvec4 blk, bool sgn)
{
    uint pos = 0u;
    uint code = bits(blk, 0u, 2u);
    pos = 2u;
    if (code > 1u) { code |= bits(blk, 2u, 3u) << 2; pos = 5u; }
    int mode = BC6_MODE_OF_CODE[code];
    if (mode < 0) {
        for (uint t = 0u; t < 16u; t++) put(t & 3u, t >> 2, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }
    int ep[12];
    for (int i = 0; i < 12; i++) ep[i] = 0;
    uint part_id = 0u;
    for (uint e = BC6_LAYOUT_START[mode]; e < BC6_LAYOUT_START[mode + 1]; e++) {
        uint d = BC6_LAYOUT[e];
        uint target = d & 15u, n = (d >> 4) & 31u, sh = (d >> 9) & 31u;
        uint v = bits(blk, pos, n);
        pos += n;
        if ((d & (1u << 14)) != 0u) v = bitfieldReverse(v) >> (32u - n);
        if (target == 12u) part_id = v;
        else ep[target] |= int(v << sh);
    }
    bool two = mode < 10;
    int npts = two ? 4 : 2;
    int w = BC6_BITS_W[mode];
    if (sgn) { ep[0] = sext(ep[0], w); ep[4] = sext(ep[4], w); ep[8] = sext(ep[8], w); }
    if ((mode != 9 && mode != 10) || sgn) {
        for (int i = 1; i < npts; i++) {
            ep[i] = sext(ep[i], BC6_BITS_DR[mode]);
            ep[4 + i] = sext(ep[4 + i], BC6_BITS_DG[mode]);
            ep[8 + i] = sext(ep[8 + i], BC6_BITS_DB[mode]);
        }
    }
    if (mode != 9 && mode != 10) {
        for (int i = 1; i < npts; i++) {
            for (int c = 0; c < 3; c++) {
                int v = (ep[c * 4 + i] + ep[c * 4]) & ((1 << w) - 1);
                ep[c * 4 + i] = sgn ? sext(v, w) : v;
            }
        }
    }
    for (int i = 0; i < 12; i++) ep[i] = bc6_unquantize(ep[i], w, sgn);
    const int w3[8] = int[8](0, 9, 18, 27, 37, 46, 55, 64);
    const int w4[16] = int[16](0, 4, 9, 13, 17, 21, 26, 30, 34, 38, 43, 47, 51, 55, 60, 64);
    uint part = BC7_PART2[part_id], anchor = BC7_PART2_ANCHOR[part_id] & 15u;
    for (uint t = 0u; t < 16u; t++) {
        uint subset = two ? ((part >> (2u * t)) & 3u) : 0u;
        uint nb = two ? 3u : 4u;
        if (t == 0u || (two && subset == 1u && t == anchor)) nb--;
        uint idx = bits(blk, pos, nb);
        pos += nb;
        int wt = two ? w3[idx] : w4[idx];
        int s2 = int(subset) * 2;
        uvec3 h;
        for (int c = 0; c < 3; c++) {
            int a = ep[c * 4 + s2], b = ep[c * 4 + s2 + 1];
            h[c] = bc6_finish((a * (64 - wt) + b * wt + 32) >> 6, sgn);
        }
        put_half(t & 3u, t >> 2, h);
    }
}

/* ------------------------------------------------------------------ BC7 */

void bc7(uvec4 blk)
{
    /* the mode is the lowest set bit of the first byte (8: none, an invalid block); found without a
     * loop, which the Mali-G1-Ultra's r54p1 driver compiled wrong when blocks of different modes
     * shared a workgroup */
    uint mode = (blk.x & 0xffu) == 0u ? 8u : uint(findLSB(blk.x & 0xffu));
#if defined(TRANSCODE)
    g_bc7_parts = 1u;
#endif
    if (mode >= 8u) {
        for (uint t = 0u; t < 16u; t++) put(t & 3u, t >> 2, vec4(0.0));
        return;
    }
    uint pos = mode + 1u;
    uint nparts = 1u, part_id = 0u, rotation = 0u, isel = 0u;
    if (mode == 0u || mode == 1u || mode == 2u || mode == 3u || mode == 7u) {
        nparts = (mode == 0u || mode == 2u) ? 3u : 2u;
        uint pb = mode == 0u ? 4u : 6u;
        part_id = bits(blk, pos, pb);
        pos += pb;
    }
    uint neps = nparts * 2u;
#if defined(TRANSCODE)
    g_bc7_parts = nparts;
    g_bc7_part = part_id;
#endif
    if (mode == 4u || mode == 5u) {
        rotation = bits(blk, pos, 2u);
        pos += 2u;
        if (mode == 4u) { isel = bits(blk, pos, 1u); pos += 1u; }
    }
    int cb = BC7_BITS_RGB[mode], ab = BC7_BITS_A[mode];
    uint ep[6][4];
    for (uint c = 0u; c < 3u; c++)
        for (uint e = 0u; e < neps; e++) { ep[e][c] = bits(blk, pos, uint(cb)); pos += uint(cb); }
    for (uint e = 0u; e < neps; e++) {
        if (ab > 0) { ep[e][3] = bits(blk, pos, uint(ab)); pos += uint(ab); }
        else ep[e][3] = 0u;
    }
    const uint has_pbits = 203u; /* 0b11001011 */
    bool pbits = ((has_pbits >> mode) & 1u) != 0u || mode == 1u;
    if (mode == 0u || mode == 1u || mode == 3u || mode == 6u || mode == 7u) {
        for (uint e = 0u; e < neps; e++)
            for (uint c = 0u; c < 4u; c++) ep[e][c] <<= 1;
        if (mode == 1u) {
            uint p0 = bits(blk, pos, 1u), p1 = bits(blk, pos + 1u, 1u);
            pos += 2u;
            for (uint c = 0u; c < 3u; c++) { ep[0][c] |= p0; ep[1][c] |= p0; ep[2][c] |= p1; ep[3][c] |= p1; }
        } else {
            for (uint e = 0u; e < neps; e++) {
                uint p = bits(blk, pos, 1u);
                pos += 1u;
                for (uint c = 0u; c < 4u; c++) ep[e][c] |= p;
            }
        }
    }
    for (uint e = 0u; e < neps; e++) {
        uint j = uint(cb) + ((has_pbits >> mode) & 1u);
        for (uint c = 0u; c < 3u; c++) {
            ep[e][c] = ep[e][c] << (8u - j);
            ep[e][c] = (ep[e][c] | (ep[e][c] >> j)) & 0xffu;
        }
        j = uint(ab) + ((has_pbits >> mode) & 1u);
        ep[e][3] = ep[e][3] << (8u - j);
        ep[e][3] = (ep[e][3] | (ep[e][3] >> j)) & 0xffu;
        if (ab == 0) ep[e][3] = 255u;
    }
    const uint w2[4] = uint[4](0u, 21u, 43u, 64u);
    const uint w3[8] = uint[8](0u, 9u, 18u, 27u, 37u, 46u, 55u, 64u);
    const uint w4[16] = uint[16](0u, 4u, 9u, 13u, 17u, 21u, 26u, 30u, 34u, 38u, 43u, 47u, 51u, 55u, 60u, 64u);
    uint ib = (mode == 0u || mode == 1u) ? 3u : (mode == 6u ? 4u : 2u);
    uint ib2 = mode == 4u ? 3u : (mode == 5u ? 2u : 0u);
    uint part = nparts == 2u ? BC7_PART2[part_id] : (nparts == 3u ? BC7_PART3[part_id] : 0u);
#if defined(TRANSCODE)
    g_bc7_mask = part;
#endif
    uint anchors = nparts == 2u ? BC7_PART2_ANCHOR[part_id] : (nparts == 3u ? BC7_PART3_ANCHOR[part_id] : 0u);
    uint idx1[16];
    for (uint t = 0u; t < 16u; t++) {
        uint subset = (part >> (2u * t)) & 3u;
        uint nb = ib;
        bool anchor = t == 0u || (subset == 1u && t == (anchors & 15u)) || (subset == 2u && t == (anchors >> 4));
        if (anchor) nb--;
        idx1[t] = bits(blk, pos, nb);
        pos += nb;
    }
    for (uint t = 0u; t < 16u; t++) {
        uint subset = (part >> (2u * t)) & 3u;
        uint e0 = subset * 2u, e1 = e0 + 1u;
        uint i1 = idx1[t];
        uvec4 c;
        if (ib2 == 0u) {
            uint wt = ib == 2u ? w2[i1] : (ib == 3u ? w3[i1] : w4[i1]);
            for (uint k = 0u; k < 4u; k++) c[k] = (ep[e0][k] * (64u - wt) + ep[e1][k] * wt + 32u) >> 6;
        } else {
            uint nb2 = t == 0u ? ib2 - 1u : ib2;
            uint i2 = bits(blk, pos, nb2);
            pos += nb2;
            uint wa = ib == 2u ? w2[i1] : w3[i1];
            uint wb = ib2 == 2u ? w2[i2] : w3[i2];
            uint wc = isel == 0u ? wa : wb, wal = isel == 0u ? wb : wa;
            for (uint k = 0u; k < 3u; k++) c[k] = (ep[e0][k] * (64u - wc) + ep[e1][k] * wc + 32u) >> 6;
            c.w = (ep[e0][3] * (64u - wal) + ep[e1][3] * wal + 32u) >> 6;
        }
        if (rotation == 1u) c = c.agbr;
        else if (rotation == 2u) c = c.rabg;
        else if (rotation == 3u) c = c.rgab;
        put(t & 3u, t >> 2, vec4(c) / 255.0);
    }
}

#if defined(BC_FAST) && defined(FMT_BC7) && defined(ENC_ASTC) && !defined(SRC_RAW)
/* bc7() for VKBRIDGE_BC_FAST: the same texels into g_pw (packed: what put() would round them to is the integer itself), the
 * same partition fields, with nothing indexed by data: the loops over endpoints and texels unrolled, a texel's endpoints picked
 * by select, its index read where it lies (bit offsets from the anchors: texel 0 and each subset's anchor, which lies in that
 * subset, hold one bit less), the weights by formula (BC7's tables are round(64 i / (n - 1)) = (128 i + n - 1) / (2 n - 2)). */
uint bc7f_w(uint b, uint i)
{
    return b == 2u ? (128u * i + 3u) / 6u : (b == 3u ? (128u * i + 7u) / 14u : (128u * i + 15u) / 30u);
}
void bc7_f(uvec4 blk)
{
    uint mode = (blk.x & 0xffu) == 0u ? 8u : uint(findLSB(blk.x & 0xffu));
    g_bc7_parts = 1u;
    if (mode >= 8u) {
        [[unroll]] for (uint t = 0u; t < 16u; t++) g_pw[t] = 0u;
        return;
    }
    uint pos = mode + 1u;
    uint nparts = 1u, part_id = 0u, rotation = 0u, isel = 0u;
    if (mode == 0u || mode == 1u || mode == 2u || mode == 3u || mode == 7u) {
        nparts = (mode == 0u || mode == 2u) ? 3u : 2u;
        uint pb = mode == 0u ? 4u : 6u;
        part_id = bits(blk, pos, pb);
        pos += pb;
    }
    uint neps = nparts * 2u;
    g_bc7_parts = nparts;
    g_bc7_part = part_id;
    if (mode == 4u || mode == 5u) {
        rotation = bits(blk, pos, 2u);
        pos += 2u;
        if (mode == 4u) { isel = bits(blk, pos, 1u); pos += 1u; }
    }
    uint cb = (0x57757564u >> (4u * mode)) & 15u, ab = (0x57860000u >> (4u * mode)) & 15u; /* BC7_BITS_RGB / _A */
    uvec4 ep[6];
    [[unroll]] for (uint c = 0u; c < 3u; c++)
        [[unroll]] for (uint e = 0u; e < 6u; e++)
            if (e < neps) { ep[e][c] = bits(blk, pos, cb); pos += cb; }
    [[unroll]] for (uint e = 0u; e < 6u; e++) {
        if (e >= neps) continue;
        if (ab > 0u) { ep[e][3] = bits(blk, pos, ab); pos += ab; }
        else ep[e][3] = 0u;
    }
    const uint has_pbits = 203u; /* 0b11001011 */
    uint hp = (has_pbits >> mode) & 1u;
    if (mode == 0u || mode == 1u || mode == 3u || mode == 6u || mode == 7u) {
        [[unroll]] for (uint e = 0u; e < 6u; e++)
            if (e < neps) ep[e] <<= 1;
        if (mode == 1u) {
            uint p0 = bits(blk, pos, 1u), p1 = bits(blk, pos + 1u, 1u);
            pos += 2u;
            ep[0].rgb |= uvec3(p0);
            ep[1].rgb |= uvec3(p0);
            ep[2].rgb |= uvec3(p1);
            ep[3].rgb |= uvec3(p1);
        } else {
            [[unroll]] for (uint e = 0u; e < 6u; e++) {
                if (e >= neps) continue;
                uint p = bits(blk, pos, 1u);
                pos += 1u;
                ep[e] |= uvec4(p);
            }
        }
    }
    uint ew[6]; /* endpoint e, 8 bits a channel (r | g << 8 | b << 16 | a << 24) */
    [[unroll]] for (uint e = 0u; e < 6u; e++) {
        uint j = cb + hp;
        uvec3 x = ep[e].rgb << (8u - j);
        x = (x | (x >> j)) & 0xffu;
        j = ab + hp;
        uint a = ep[e][3] << (8u - j);
        a = (a | (a >> j)) & 0xffu;
        if (ab == 0u) a = 255u;
        ew[e] = x.r | (x.g << 8) | (x.b << 16) | (a << 24);
    }
    uint ib = (mode == 0u || mode == 1u) ? 3u : (mode == 6u ? 4u : 2u);
    uint ib2 = mode == 4u ? 3u : (mode == 5u ? 2u : 0u);
    uint part = nparts == 2u ? BC7_PART2[part_id] : (nparts == 3u ? BC7_PART3[part_id] : 0u);
    g_bc7_mask = part;
    uint anchors = nparts == 2u ? BC7_PART2_ANCHOR[part_id] : (nparts == 3u ? BC7_PART3_ANCHOR[part_id] : 0u);
    uint a1 = nparts > 1u ? anchors & 15u : 16u, a2 = nparts > 2u ? anchors >> 4 : 16u;
    uint pos2 = pos + 16u * ib - nparts; /* the second index set (modes 4, 5: one subset) */
    [[unroll]] for (uint t = 0u; t < 16u; t++) {
        uint subset = (part >> (2u * t)) & 3u;
        uint at = pos + t * ib - (t > 0u ? 1u : 0u) - (t > a1 ? 1u : 0u) - (t > a2 ? 1u : 0u);
        bool anchor = t == 0u || t == a1 || t == a2;
        uint i1 = bits(blk, at, anchor ? ib - 1u : ib);
        uint w0 = subset == 0u ? ew[0] : (subset == 1u ? ew[2] : ew[4]), w1 = subset == 0u ? ew[1] : (subset == 1u ? ew[3] : ew[5]);
        uvec4 e0 = (uvec4(w0) >> uvec4(0u, 8u, 16u, 24u)) & 0xffu, e1 = (uvec4(w1) >> uvec4(0u, 8u, 16u, 24u)) & 0xffu;
        uvec4 c;
        if (ib2 == 0u) {
            uint wt = bc7f_w(ib, i1);
            c = (e0 * (64u - wt) + e1 * wt + 32u) >> 6;
        } else {
            uint i2 = bits(blk, pos2 + t * ib2 - (t > 0u ? 1u : 0u), t == 0u ? ib2 - 1u : ib2);
            uint wa = bc7f_w(ib, i1), wb = bc7f_w(ib2, i2);
            uint wc = isel == 0u ? wa : wb, wal = isel == 0u ? wb : wa;
            c.rgb = (e0.rgb * (64u - wc) + e1.rgb * wc + 32u) >> 6;
            c.w = (e0.w * (64u - wal) + e1.w * wal + 32u) >> 6;
        }
        if (rotation == 1u) c = c.agbr;
        else if (rotation == 2u) c = c.rabg;
        else if (rotation == 3u) c = c.rgab;
        g_pw[t] = c.r | (c.g << 8) | (c.b << 16) | (c.a << 24);
    }
}
#endif

/* ------------------------------------------------------------------ SRC_RAW */

#if defined(SRC_RAW)
/* The source holds texels, rows of 4 * row_blocks of them and 4 * (rows of tiles) rows a layer
 * (row_blocks, layer_blocks: in 4x4 tiles). The first word of row ty of tile (bx, by) in layer z. */
uint raw_row_words()
{
#if defined(FMT_BC4)
    return 1u;
#elif defined(FMT_BC5)
    return 2u;
#elif defined(FMT_BC6H)
    return 8u;
#else
    return (pc.flags & 24u) != 0u ? 2u : 4u;
#endif
}

uint raw_word(uint z, uint bx, uint by, uint ty)
{
    uint rw = raw_row_words();
    return pc.src_word + (z * pc.layer_blocks + by * pc.row_blocks) * 4u * rw + ty * pc.row_blocks * rw + bx * rw;
}

#if defined(FMT_BC4) || defined(FMT_BC5)
/* Channel ch of a tile, in EAC R11 units (bc4_exact's) */
void raw_eac(uint z, uint bx, uint by, uint ch, bool sgn, out float v[16])
{
    for (uint ty = 0u; ty < 4u; ty++) {
        uint w0 = raw_word(z, bx, by, ty);
        for (uint tx = 0u; tx < 4u; tx++) {
#if defined(FMT_BC4)
            uint b = (src.w[w0] >> (tx * 8u)) & 0xffu;
#else
            uint b = (src.w[w0 + (tx >> 1)] >> ((tx & 1u) * 16u + ch * 8u)) & 0xffu;
#endif
            v[ty * 4u + tx] = sgn ? float(max(sext(int(b), 8), -127)) * (1023.0 / 127.0) : float(b) * (2047.0 / 255.0);
        }
    }
}
#elif defined(FMT_BC6H)
void raw_half(uint z, uint bx, uint by)
{
    for (uint ty = 0u; ty < 4u; ty++) {
        uint w0 = raw_word(z, bx, by, ty);
        for (uint tx = 0u; tx < 4u; tx++) {
            uint a = src.w[w0 + tx * 2u], b = src.w[w0 + tx * 2u + 1u];
            put_half(tx, ty, uvec3(a & 0xffffu, a >> 16, b & 0xffffu));
        }
    }
}
#else
void raw_rgba(uint z, uint bx, uint by)
{
    for (uint ty = 0u; ty < 4u; ty++) {
        uint w0 = raw_word(z, bx, by, ty);
        for (uint tx = 0u; tx < 4u; tx++) {
            uvec4 c;
            if ((pc.flags & 24u) != 0u) {
                uint p = (src.w[w0 + (tx >> 1)] >> ((tx & 1u) * 16u)) & 0xffffu;
                if ((pc.flags & 8u) != 0u) c = rgb565(p);
                else c = uvec4((((p >> 10) & 31u) * 527u + 23u) >> 6, (((p >> 5) & 31u) * 527u + 23u) >> 6, ((p & 31u) * 527u + 23u) >> 6,
                               (p >> 15) * 255u);
            } else {
                uint w = src.w[w0 + tx];
                c = uvec4(w & 0xffu, (w >> 8) & 0xffu, (w >> 16) & 0xffu, w >> 24);
            }
            if ((pc.flags & 1u) != 0u) c.w = 255u;
            put(tx, ty, vec4(c) / 255.0);
        }
    }
}
#endif
#endif

/* ------------------------------------------------------------------ main */

/* Texel t, or where it lies past the region's edge (a small mip's), the nearest one inside: the
 * encoder then fits only what can be seen. */
uint seen(uint t, uvec2 blk)
{
    uvec2 lim = min(EXTENT - blk * 4u, uvec2(4u));
    return min(t >> 2, lim.y - 1u) * 4u + min(t & 3u, lim.x - 1u);
}

#if defined(BC_PALETTE) && defined(ENC_ETC2) && !defined(SRC_RAW)
/* BC1 -> ETC2 by palette (BC_PALETTE): the block's four colours and each texel's colour, as color_block and put()
 * would give the texels (transparent: alpha 0, a colour of black; flags & 1 forces alpha 255), a texel past the
 * region's edge as the nearest one inside (seen). */
void pe_load(uint lo, uint idx, uvec2 blk)
{
    uint c0 = lo & 0xffffu, c1 = lo >> 16;
    uint r0 = (c0 >> 11) & 31u, g0 = (c0 >> 5) & 63u, b0 = c0 & 31u;
    uint r1 = (c1 >> 11) & 31u, g1 = (c1 >> 5) & 63u, b1 = c1 & 31u;
    uvec4 ref[4];
    ref[0] = rgb565(c0);
    ref[1] = rgb565(c1);
    if (c0 > c1) {
        ref[2] = uvec4(((2u * r0 + r1) * 351u + 61u) >> 7, ((2u * g0 + g1) * 2763u + 1039u) >> 11, ((2u * b0 + b1) * 351u + 61u) >> 7, 255u);
        ref[3] = uvec4(((r0 + r1 * 2u) * 351u + 61u) >> 7, ((g0 + g1 * 2u) * 2763u + 1039u) >> 11, ((b0 + b1 * 2u) * 351u + 61u) >> 7, 255u);
    } else {
        ref[2] = uvec4(((r0 + r1) * 1053u + 125u) >> 8, ((g0 + g1) * 4145u + 1019u) >> 11, ((b0 + b1) * 1053u + 125u) >> 8, 255u);
        ref[3] = uvec4(0u);
    }
    g_pcl = 0u;
    for (uint k = 0u; k < 4u; k++) {
#if defined(BC_FAST)
        g_pcw[k] = ref[k].r | (ref[k].g << 8) | (ref[k].b << 16);
#else
        g_pc[k] = ivec3(ref[k].rgb);
#endif
        uint a = (pc.flags & 1u) != 0u ? 255u : ref[k].a;
        if ((pc.flags & 4u) != 0u && a < 128u) g_pcl |= 1u << k;
    }
    g_pidx = 0u;
    for (uint t = 0u; t < 16u; t++) g_pidx |= ((idx >> (2u * seen(t, blk))) & 3u) << (2u * t);
}
#endif

#if defined(BC_PALETTE) && defined(ENC_EAC) && !defined(SRC_RAW)
/* One BC4 channel (its 64 bits) by palette (BC_PALETTE): its 8 values made by bc4_exact itself (the arithmetic of
 * the texel-domain path, on an index pattern that gives texel j value j), each texel's value (seen: past the
 * region's edge, the nearest inside), and which values are used (eac_enc.glsl eac_encode_p). */
void eac_pal_load(uint lo, uint hi, bool sgn, uvec2 blk)
{
    float v[16];
    bc4_exact((lo & 0xffffu) | (0xc688u << 16), 0xfau, sgn, v); /* indices 0, 1, ..., 7 on texels 0-7: 0xfac688 from bit 16 */
    for (uint j = 0u; j < 8u; j++) eac_pv[j] = v[j];
    uvec4 b = uvec4(lo, hi, 0u, 0u);
    eac_pi = uvec2(0u);
    eac_used = 0u;
    for (uint t = 0u; t < 16u; t++) {
        uint k = bits(b, 16u + 3u * seen(t, blk), 3u);
        if (t < 8u) eac_pi.x |= k << (4u * t);
        else eac_pi.y |= k << (4u * (t - 8u));
        eac_used |= 1u << k;
    }
}
#endif

#if defined(ENC_ASTCN)
/* ENC_ASTCN: one invocation per ASTC_N x ASTC_N block. Its texels come from the BC blocks under it
 * (2x2 for 8x8, 2 or 3 a side for 6x6), each decoded into g_px; texels past the region's edges (a
 * small mip's, or a region that does not start or end on an ASTC block's edge) repeat the nearest
 * inside, so the encoder fits what can be seen. */
void decode_rgba(uvec4 b)
{
#if defined(FMT_BC1)
    uvec4 tex[16];
    color_block(b.x, b.y, false, tex);
    for (uint t = 0u; t < 16u; t++) {
        uvec4 c = tex[t];
        if ((pc.flags & 1u) != 0u) c.w = 255u;
        put(t & 3u, t >> 2, vec4(c) / 255.0);
    }
#elif defined(FMT_BC2) || defined(FMT_BC3)
    uvec4 tex[16];
    color_block(b.z, b.w, true, tex);
    uint a[16];
#if defined(FMT_BC2)
    for (uint t = 0u; t < 16u; t++) a[t] = bits(b, 4u * t, 4u) * 17u;
#else
    smooth_alpha(b.x, b.y, a);
#endif
    for (uint t = 0u; t < 16u; t++) put(t & 3u, t >> 2, vec4(tex[t].rgb, a[t]) / 255.0);
#elif defined(FMT_BC7)
    bc7(b);
#endif
}

void main()
{
    const uint N = uint(ASTC_N);
    uvec2 ab = gl_GlobalInvocationID.xy;
    uvec2 nab = (pc.extent + N - 1u) / N;
    if (ab.x >= nab.x || ab.y >= nab.y) return;
#if defined(FMT_BC1)
    uint words = 2u;
#else
    uint words = 4u;
#endif
    uint sx = pc.nx.x & 15u, sy = (pc.nx.x >> 4) & 15u, r0 = pc.nx.x >> 8;
    /* this block's texels inside the piece, and where they come from in the region */
    uvec2 lim = min(pc.extent - ab * N, uvec2(N));
    uint u0 = ab.x * N, v0 = pc.nx.y + ab.y * N;
    uvec2 smin = uvec2(u0 > sx ? u0 - sx : 0u, v0 > sy ? v0 - sy : 0u);
    uvec2 smax = min(uvec2(u0 + lim.x - 1u, v0 + lim.y - 1u), uvec2(sx, sy) + pc.nx.zw - 1u);
    smax = uvec2(smax.x > sx ? smax.x - sx : 0u, smax.y > sy ? smax.y - sy : 0u);
    smin = min(smin, smax);
    for (uint by = smin.y / 4u; by <= smax.y / 4u; by++)
        for (uint bx = smin.x / 4u; bx <= smax.x / 4u; bx++) {
#if defined(SRC_RAW)
            raw_rgba(gl_GlobalInvocationID.z, bx, by - r0);
#else
            uint base = pc.src_word + (gl_GlobalInvocationID.z * pc.layer_blocks + (by - r0) * pc.row_blocks + bx) * words;
            decode_rgba(uvec4(src.w[base], src.w[base + 1u], words > 2u ? src.w[base + 2u] : 0u, words > 2u ? src.w[base + 3u] : 0u));
#endif
            for (uint j = 0u; j < N; j++)
                for (uint i = 0u; i < N; i++) {
                    uint u = u0 + min(i, lim.x - 1u), v = v0 + min(j, lim.y - 1u);
                    uvec2 s = clamp(uvec2(u > sx ? u - sx : 0u, v > sy ? v - sy : 0u), smin, smax);
                    if (s.x / 4u == bx && s.y / 4u == by) {
                        ivec4 c = g_px[(s.y & 3u) * 4u + (s.x & 3u)];
                        g_bpx[j * N + i] = uint(c.r) | (uint(c.g) << 8) | (uint(c.b) << 16) | (uint(c.a) << 24);
                    }
                }
        }
    uvec4 enc = astcn_encode();
    uint o = pc.dst_word + ((gl_GlobalInvocationID.z * nab.y + ab.y) * nab.x + ab.x) * 4u;
    for (uint k = 0u; k < 4u; k++) dst.w[o + k] = enc[k];
}
#else
#if defined(FMT_BC1) && defined(ENC_ASTC)
/* BC1 -> ASTC 4x4 without a search (VKBRIDGE_BC1_ASTC): a BC1 block is two colours and a 2-bit
 * index a texel, which an ASTC block of one partition holds as they are, endpoints at 8 bits. Four
 * colours: 2-bit weights (ASTC's 0, 21, 43, 64 against BC1's thirds: within a step). Three colours:
 * the midpoint is weight 1 of 3 levels (0, 32, 64), exact. A three-colour block that uses its
 * fourth index (black, transparent in BC1 with alpha) is off the line: false, and the block goes
 * through astc_encode() - ASTC has no punch-through, so a transparent texel's colour is fitted. */
bool bc1_astc(uint lo, uint idx, out uvec4 blk)
{
    blk = uvec4(0u);
    uint c0 = lo & 0xffffu, c1 = lo >> 16;
    bool four = c0 > c1;
    if (!four)
        for (uint t = 0u; t < 16u; t++)
            if (((idx >> (2u * t)) & 3u) == 3u) return false;
    uvec4 e0 = rgb565(c0), e1 = rgb565(c1);
    /* the decoder swaps (and blue-contracts) endpoints whose second colour sums lower */
    bool swap = e1.r + e1.g + e1.b < e0.r + e0.g + e0.b;
    if (swap) { uvec4 x = e0; e0 = e1; e1 = x; }
    /* weights from the top of the block down: 2 bits each, or trits in groups of 5 (astc_ise's
     * layout with no bits besides) */
    uvec4 w = uvec4(0u);
    if (four) {
        for (uint t = 0u; t < 16u; t++) {
            uint k = (idx >> (2u * t)) & 3u, q = k == 0u ? 0u : (k == 1u ? 3u : (k == 2u ? 1u : 2u));
            astc_put(w, 2u * t, 2u, swap ? 3u - q : q);
        }
    } else {
        uint pos = 0u;
        for (uint g = 0u; g < 16u; g += 5u) {
            uint x[5];
            for (uint j = 0u; j < 5u; j++) {
                uint k = g + j < 16u ? (idx >> (2u * (g + j))) & 3u : 0u, q = k == 1u ? 2u : (k == 2u ? 1u : 0u);
                x[j] = swap ? 2u - q : q;
            }
            uint tq = astc_trits(x[0], x[1], x[2], x[3], x[4]);
            for (uint j = 0u; j < 5u && g + j < 16u; j++) {
                uint k = j == 2u || j == 4u ? 1u : 2u, sh = 2u * j - (j >= 3u ? 1u : 0u);
                astc_put(w, pos, k, tq >> sh);
                pos += k;
            }
        }
    }
    /* block mode: 4x4 weights, range R 4 (2 bits) or 3 (trits); one partition, CEM 8 (RGB direct) */
    uint r = four ? 4u : 3u;
    astc_put(blk, 0u, 11u, ((r >> 1) & 3u) | ((r & 1u) << 4) | (2u << 5));
    astc_put(blk, 13u, 4u, 8u);
    for (uint c = 0u; c < 3u; c++) {
        astc_put(blk, 17u + 16u * c, 8u, e0[c]);
        astc_put(blk, 25u + 16u * c, 8u, e1[c]);
    }
    blk |= uvec4(bitfieldReverse(w.w), bitfieldReverse(w.z), bitfieldReverse(w.y), bitfieldReverse(w.x));
    return true;
}
#endif

void main()
{
#if defined(REGION_TABLE)
    region_find();
#endif
    uvec2 blk = GID.xy;
    uvec2 nblk = (EXTENT + 3u) / 4u;
    if (blk.x >= nblk.x || blk.y >= nblk.y) return;
#if defined(FMT_BC1) || defined(FMT_BC4)
    uint words = 2u;
#else
    uint words = 4u;
#endif
#if !defined(TRANSCODE)
    for (uint i = 0u; i < 4u * ROW_WORDS; i++) outw[i] = 0u;
#endif
#if !defined(SRC_RAW)
    uint base = SRC_WORD + (GID.z * LAYER_BLOCKS + blk.y * ROW_BLOCKS + blk.x) * words;
    uvec4 b = uvec4(src.w[base], src.w[base + 1u], words > 2u ? src.w[base + 2u] : 0u, words > 2u ? src.w[base + 3u] : 0u);
#endif
    bool sgn = (pc.flags & 2u) != 0u;
#if defined(SRC_RAW) && defined(FMT_BC4)
    float v[16];
    raw_eac(gl_GlobalInvocationID.z, blk.x, blk.y, 0u, sgn, v);
    for (uint t = 0u; t < 16u; t++) v[t] = v[seen(t, blk)];
    uvec4 enc = uvec4(eac_encode(v, sgn), 0u, 0u);
#elif defined(SRC_RAW) && defined(FMT_BC5)
    float r[16], g[16];
    raw_eac(gl_GlobalInvocationID.z, blk.x, blk.y, 0u, sgn, r);
    raw_eac(gl_GlobalInvocationID.z, blk.x, blk.y, 1u, sgn, g);
    for (uint t = 0u; t < 16u; t++) {
        r[t] = r[seen(t, blk)];
        g[t] = g[seen(t, blk)];
    }
    uvec4 enc = uvec4(eac_encode(r, sgn), eac_encode(g, sgn));
#elif defined(SRC_RAW) && defined(FMT_BC6H)
    raw_half(gl_GlobalInvocationID.z, blk.x, blk.y);
#elif defined(SRC_RAW)
    raw_rgba(gl_GlobalInvocationID.z, blk.x, blk.y);
#elif defined(FMT_BC1) && defined(ENC_ETC2) && defined(BC_PALETTE)
    pe_load(b.x, b.y, blk);
#elif defined(FMT_BC4) && defined(ENC_EAC) && defined(BC_PALETTE)
    eac_pal_load(b.x, b.y, sgn, blk);
    uvec4 enc = uvec4(eac_encode_p(sgn), 0u, 0u);
#elif defined(FMT_BC5) && defined(ENC_EAC) && defined(BC_PALETTE)
    eac_pal_load(b.x, b.y, sgn, blk);
    uvec2 er = eac_encode_p(sgn);
    eac_pal_load(b.z, b.w, sgn, blk);
    uvec4 enc = uvec4(er, eac_encode_p(sgn)); /* two copies of the search fit Mali's registers; a loop over the channels did not */
#elif defined(FMT_BC1)
    uvec4 tex[16];
    color_block(b.x, b.y, false, tex);
    for (uint t = 0u; t < 16u; t++) {
        uvec4 c = tex[t];
        if ((pc.flags & 1u) != 0u) c.w = 255u;
        put(t & 3u, t >> 2, vec4(c) / 255.0);
    }
#elif defined(FMT_BC2) || defined(FMT_BC3)
    uvec4 tex[16];
    color_block(b.z, b.w, true, tex);
    uint a[16];
#if defined(FMT_BC2)
    for (uint t = 0u; t < 16u; t++) a[t] = bits(b, 4u * t, 4u) * 17u;
#else
    smooth_alpha(b.x, b.y, a);
#endif
    for (uint t = 0u; t < 16u; t++) put(t & 3u, t >> 2, vec4(tex[t].rgb, a[t]) / 255.0);
#elif defined(FMT_BC4) && defined(ENC_EAC)
    float v[16];
    bc4_exact(b.x, b.y, sgn, v);
    for (uint t = 0u; t < 16u; t++) v[t] = v[seen(t, blk)];
    uvec4 enc = uvec4(eac_encode(v, sgn), 0u, 0u);
#elif defined(FMT_BC5) && defined(ENC_EAC)
    float r[16], g[16];
    bc4_exact(b.x, b.y, sgn, r);
    bc4_exact(b.z, b.w, sgn, g);
    for (uint t = 0u; t < 16u; t++) {
        r[t] = r[seen(t, blk)];
        g[t] = g[seen(t, blk)];
    }
    uvec4 enc = uvec4(eac_encode(r, sgn), eac_encode(g, sgn));
#elif defined(FMT_BC4)
    uint v[16];
    bc4_channel(b.x, b.y, sgn, v);
    for (uint t = 0u; t < 16u; t++) put(t & 3u, t >> 2, vec4(float(v[t]) / 255.0, 0.0, 0.0, 1.0));
#elif defined(FMT_BC5)
    uint r[16], g[16];
    bc4_channel(b.x, b.y, sgn, r);
    bc4_channel(b.z, b.w, sgn, g);
    for (uint t = 0u; t < 16u; t++) put(t & 3u, t >> 2, vec4(float(r[t]) / 255.0, float(g[t]) / 255.0, 0.0, 1.0));
#elif defined(FMT_BC6H)
    bc6h(b, sgn);
#elif defined(FMT_BC7) && defined(BC_FAST) && defined(ENC_ASTC)
    bc7_f(b);
#elif defined(FMT_BC7)
    bc7(b);
#endif
#if defined(ENC_ASTC_HDR)
    for (uint t = 0u; t < 16u; t++) g_hpx[t] = g_hpx[seen(t, blk)];
#elif defined(FMT_BC7) && defined(BC_FAST) && defined(ENC_ASTC)
    {
        /* seen(), by select: columns past the edge copy the one before them, then rows */
        uvec2 lim = min(EXTENT - blk * 4u, uvec2(4u));
        [[unroll]] for (uint y = 0u; y < 4u; y++)
            [[unroll]] for (uint x = 1u; x < 4u; x++)
                if (x >= lim.x) g_pw[y * 4u + x] = g_pw[y * 4u + x - 1u];
        [[unroll]] for (uint y = 1u; y < 4u; y++)
            [[unroll]] for (uint x = 0u; x < 4u; x++)
                if (y >= lim.y) g_pw[y * 4u + x] = g_pw[y * 4u + x - 4u];
    }
#elif defined(TRANSCODE) && !defined(ENC_EAC) && !(defined(ENC_ETC2) && defined(BC_PALETTE))
    for (uint t = 0u; t < 16u; t++) g_px[t] = g_px[seen(t, blk)];
#endif
#if defined(TRANSCODE)
#if defined(ENC_ETC2) && defined(BC_PALETTE)
    uvec4 enc = uvec4(etc2_encode_p((pc.flags & 4u) != 0u), 0u, 0u);
#elif defined(ENC_ETC2)
    uvec4 enc = uvec4(etc2_encode((pc.flags & 4u) != 0u), 0u, 0u);
#elif defined(ENC_ASTC) && defined(SRC_RAW)
    uvec4 enc = astc_encode(~0u, (pc.flags & 32u) != 0u);
#elif defined(ENC_ASTC) && defined(FMT_BC7) && defined(BC_FAST)
    /* as below, the subsets' sums by select */
    uint part = ~0u;
    if (g_bc7_parts > 1u) {
        uint i = g_bc7_part;
        if (g_bc7_parts == 3u) {
            vec3 sum0 = vec3(0.0), sum1 = vec3(0.0), sum2 = vec3(0.0);
            float n0 = 0.0, n1 = 0.0, n2 = 0.0;
            [[unroll]] for (uint t = 0u; t < 16u; t++) {
                uint k = (g_bc7_mask >> (2u * t)) & 3u;
                vec3 v = af_px(g_pw[t]).rgb;
                if (k == 0u) { sum0 += v; n0 += 1.0; }
                else if (k == 1u) { sum1 += v; n1 += 1.0; }
                else { sum2 += v; n2 += 1.0; }
            }
            sum0 /= max(n0, 1.0);
            sum1 /= max(n1, 1.0);
            sum2 /= max(n2, 1.0);
            float d01 = distance(sum0, sum1), d02 = distance(sum0, sum2), d12 = distance(sum1, sum2);
            uint alone = d01 <= d02 && d01 <= d12 ? 2u : (d02 <= d12 ? 1u : 0u);
            i = 64u + g_bc7_part * 3u + alone;
        }
        part = ASTC_BC7P[i];
    }
    uvec4 enc = astc_encode_f(part);
#elif defined(ENC_ASTC) && defined(FMT_BC7)
    /* BC7's partition, as the nearest ASTC one; of 3 subsets, the two closest in colour merged (one
     * lookup: a table indexed at run time may be copied whole each time) */
    uint part = ~0u;
    if (g_bc7_parts > 1u) {
        uint i = g_bc7_part;
        if (g_bc7_parts == 3u) {
            vec3 sum[3] = vec3[3](vec3(0.0), vec3(0.0), vec3(0.0));
            float n[3] = float[3](0.0, 0.0, 0.0);
            for (uint t = 0u; t < 16u; t++) {
                uint k = (g_bc7_mask >> (2u * t)) & 3u;
                sum[k] += vec3(g_px[t].rgb);
                n[k] += 1.0;
            }
            for (uint k = 0u; k < 3u; k++) sum[k] /= max(n[k], 1.0);
            float d01 = distance(sum[0], sum[1]), d02 = distance(sum[0], sum[2]), d12 = distance(sum[1], sum[2]);
            uint alone = d01 <= d02 && d01 <= d12 ? 2u : (d02 <= d12 ? 1u : 0u);
            i = 64u + g_bc7_part * 3u + alone;
        }
        part = ASTC_BC7P[i];
    }
    uvec4 enc = astc_encode(part, true);
#elif defined(ENC_ASTC_HDR)
    uvec4 enc = astc_hdr_encode();
#elif defined(ENC_ASTC) && defined(FMT_BC1) && !defined(SRC_RAW)
    uvec4 enc;
    if (!bc1_astc(b.x, b.y, enc)) enc = astc_encode(~0u, false);
#elif defined(ENC_ASTC)
    uvec4 enc = astc_encode(~0u, false);
#endif
#if defined(ENC_ASTC) || defined(ENC_ASTC_HDR) || defined(FMT_BC5)
    const uint ow = 4u;
#else
    const uint ow = 2u;
#endif
    uint o = DST_WORD + ((GID.z * nblk.y + blk.y) * nblk.x + blk.x) * ow;
    for (uint k = 0u; k < ow; k++) dst.w[o + k] = enc[k];
#else
    uint row = nblk.x * ROW_WORDS;
    uint o = DST_WORD + (GID.z * nblk.y * 4u + blk.y * 4u) * row + blk.x * ROW_WORDS;
    for (uint ty = 0u; ty < 4u; ty++)
        for (uint k = 0u; k < ROW_WORDS; k++) dst.w[o + ty * row + k] = outw[ty * ROW_WORDS + k];
#endif
}
#endif
